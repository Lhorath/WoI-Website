Options -Indexes

RewriteEngine On

# Keep certificate validation and legitimate well-known resources reachable.
RewriteRule ^\.well-known/ - [L]

# Deny hidden files and Git metadata.
RewriteRule (^|/)\. - [F,L]

# Protect MVC internals and runtime data in the root-document-root deployment.
RewriteRule ^(app|config|routes|storage)(/|$) - [F,L,NC]
RewriteRule ^utility/(cache|logs)(/|$) - [F,L,NC]
RewriteRule ^utility/(settings|header|header2|functions_[^/]+|site_structure|recaptchalib)\.php$ - [F,L,NC]

<FilesMatch "^\.env(\..*)?$">
    Require all denied
</FilesMatch>

ErrorDocument 401 /utility/errors/401.php
ErrorDocument 403 /utility/errors/403.php
ErrorDocument 404 /utility/errors/404.php
ErrorDocument 500 /utility/errors/500.php

DirectoryIndex index.php

# The homepage and these existing directories have clean MVC route aliases.
RewriteRule ^$ index.php [QSA,L]
RewriteRule ^(account|donate|gm|vote)/?$ index.php [QSA,L,NC]

# Preserve extension-based legacy links; do not redirect to localhost.
RewriteRule ^(.+)\.htm$ /$1.php [R=301,L,NC]
RewriteRule ^(.+)\.html$ /$1.php [R=301,L,NC]

# Keep existing physical files and directories working.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Dispatch all remaining clean URLs to the front controller.
RewriteRule ^ index.php [QSA,L]
